KAIRO_PRIMARY.ENV="local"

KAIRO_SERVER.PORT="8080"
KAIRO_SERVER.READ_TIMEOUT="30"
KAIRO_SERVER.WRITE_TIMEOUT="30"
KAIRO_SERVER.IDLE_TIMEOUT="60"
KAIRO_SERVER.CORS_ALLOWED_ORIGINS="http://localhost:3000"

KAIRO_DATABASE.HOST="localhost"
KAIRO_DATABASE.PORT="5432"
KAIRO_DATABASE.USER="postgres"
KAIRO_DATABASE.PASSWORD=""
KAIRO_DATABASE.NAME="KAIRO"
KAIRO_DATABASE.SSL_MODE="disable"
KAIRO_DATABASE.MAX_OPEN_CONNS="25"
KAIRO_DATABASE.MAX_IDLE_CONNS="25"
KAIRO_DATABASE.CONN_MAX_LIFETIME="300"
KAIRO_DATABASE.CONN_MAX_IDLE_TIME="300"

KAIRO_AUTH.SECRET_KEY="secret"

KAIRO_INTEGRATION.RESEND_API_KEY="resend_key"

KAIRO_REDIS.ADDRESS="redis://localhost:6379"

# ============================================================================
# OBSERVABILITY CONFIGURATION
# ============================================================================

# Service Identity
KAIRO_OBSERVABILITY.SERVICE_NAME="KAIRO"
KAIRO_OBSERVABILITY.ENVIRONMENT="development"

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Basic Logging Settings
KAIRO_OBSERVABILITY.LOGGING.LEVEL="debug"
KAIRO_OBSERVABILITY.LOGGING.FORMAT="console"
KAIRO_OBSERVABILITY.LOGGING.SLOW_QUERY_THRESHOLD="100ms"

# ============================================================================
# NEW RELIC CONFIGURATION
# ============================================================================

# New Relic APM
KAIRO_OBSERVABILITY.NEW_RELIC.LICENSE_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
KAIRO_OBSERVABILITY.NEW_RELIC.APP_LOG_FORWARDING_ENABLED="true"
KAIRO_OBSERVABILITY.NEW_RELIC.DISTRIBUTED_TRACING_ENABLED="true"
KAIRO_OBSERVABILITY.NEW_RELIC.DEBUG_LOGGING="false"

# ============================================================================
# HEALTH CHECKS CONFIGURATION
# ============================================================================

# Health Check Settings
KAIRO_OBSERVABILITY.HEALTH_CHECKS.ENABLED="true"
KAIRO_OBSERVABILITY.HEALTH_CHECKS.INTERVAL="30s"
KAIRO_OBSERVABILITY.HEALTH_CHECKS.TIMEOUT="5s"
KAIRO_OBSERVABILITY.HEALTH_CHECKS.CHECKS="database,redis"
